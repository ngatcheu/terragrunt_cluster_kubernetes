#!/usr/bin/env bash
# Généré par Terraform (module proxmox-vm-template) — ne pas éditer à la main.
set -euo pipefail

TEMPLATE_ID=${template_vm_id}
TEMPLATE_NAME="${template_name}"
STORAGE="${storage}"
MEMORY=${memory}
CORES=${cores}
BRIDGE="${network_bridge}"
IMAGE_URL="${image_url}"
CI_USER="${cloud_init_user}"
WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

echo "========================================="
echo "Template $TEMPLATE_NAME (ID: $TEMPLATE_ID)"
echo "========================================="

# Idempotence : on ne reconstruit jamais un template existant.
if qm status "$TEMPLATE_ID" &>/dev/null; then
  echo "✓ Template existe déjà (ID: $TEMPLATE_ID)"
  exit 0
fi

echo "Téléchargement de l'image..."
wget -q -O "$WORKDIR/image.qcow2" "$IMAGE_URL"

echo "Création de la VM..."
qm create "$TEMPLATE_ID" --name "$TEMPLATE_NAME" --memory "$MEMORY" \
  --net0 "virtio,bridge=$BRIDGE" --cores "$CORES" --cpu host

echo "Import du disque..."
qm importdisk "$TEMPLATE_ID" "$WORKDIR/image.qcow2" "$STORAGE"

echo "Configuration..."
qm set "$TEMPLATE_ID" --scsihw virtio-scsi-pci --scsi0 "$STORAGE:vm-$TEMPLATE_ID-disk-0"
qm set "$TEMPLATE_ID" --ide2 "$STORAGE:cloudinit"
qm set "$TEMPLATE_ID" --boot c --bootdisk scsi0
qm set "$TEMPLATE_ID" --serial0 socket --vga serial0
qm set "$TEMPLATE_ID" --agent enabled=1
qm set "$TEMPLATE_ID" --ciuser "$CI_USER"
qm set "$TEMPLATE_ID" --ipconfig0 ip=dhcp

echo "Conversion en template..."
qm template "$TEMPLATE_ID"

echo "✓ Template créé avec succès"
