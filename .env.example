# Copier en .env (ignoré par Git) puis renseigner les valeurs :
#   cp .env.example .env && chmod 600 .env
# Le Makefile charge et exporte ce fichier automatiquement.
# Hors Makefile : set -a; source .env; set +a

# Unités proxmox-template et vms
# (ex credentials.auto.tfvars : proxmox_password)
TF_VAR_proxmox_password=

# Unité fluxcd — PAT GitHub, scope "repo"
# (ex secrets.auto.tfvars : github_token)
TF_VAR_github_token=
